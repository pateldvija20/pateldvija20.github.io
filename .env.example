# Contact form (api/contact.ts) — set these in the Vercel project's
# Environment Variables, not in a committed .env file.

# From resend.com → API Keys.
RESEND_API_KEY=

# Where submissions are delivered. Defaults to pateldvija20@gmail.com if unset.
CONTACT_TO_EMAIL=pateldvija20@gmail.com

# Must be an address on a domain verified in Resend. Resend's shared
# onboarding@resend.dev works for testing but has limited deliverability.
CONTACT_FROM_EMAIL="Portfolio Reachout <onboarding@resend.dev>"
